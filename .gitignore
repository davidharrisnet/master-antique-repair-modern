# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle: build output and caches; the wrapper jar must stay (it is excluded by *.jar above)
.gradle/
build/
!**/gradle/wrapper/gradle-wrapper.jar

# IDEs (bin/ is the VS Code Java extension's compile output, beside Gradle's build/)
bin/
.idea/
*.iml
.vscode/

# Local environment files (may hold MAR_DB_PASSWORD)
.env
*.env
